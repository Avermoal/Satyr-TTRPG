<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name campaign_menu_element.ui -->
  <requires lib="gtk" version="4.18"/>
  <object class="GtkBox">
    <property name="spacing">8</property>
    <property name="valign">center</property>
    <child>
      <object class="GtkButton" id="campaign_btn">
        <property name="css-classes">campaign-btn</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="delete_camapaign_btn">
        <property name="icon-name">list-remove</property>
      </object>
    </child>
  </object>
</interface>
