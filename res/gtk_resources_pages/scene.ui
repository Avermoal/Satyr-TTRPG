<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name scene.ui -->
  <requires lib="gtk" version="4.12"/>
  <object class="GtkGrid" id="scene_list_element">
    <child>
      <object class="GtkPicture" id="scene_img">
        <layout>
          <property name="column">1</property>
          <property name="column-span">1</property>
          <property name="row">1</property>
          <property name="row-span">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="scene_label">
        <layout>
          <property name="column">1</property>
          <property name="column-span">1</property>
          <property name="row">2</property>
          <property name="row-span">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="delete_scene_btn">
        <property name="icon-name">list-remove-symbolic</property>
        <layout>
          <property name="column">2</property>
          <property name="column-span">1</property>
          <property name="row">0</property>
          <property name="row-span">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="open_scene_btn">
        <property name="label">Open</property>
        <layout>
          <property name="column">0</property>
          <property name="column-span">1</property>
          <property name="row">0</property>
          <property name="row-span">1</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
